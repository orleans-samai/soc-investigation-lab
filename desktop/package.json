{
  "name": "soc-investigation-lab",
  "productName": "SOC Investigation Lab",
  "version": "1.0.0",
  "description": "Security Operations & Incident Investigation Simulator",
  "author": {
    "name": "SOC Investigation Lab",
    "email": "noreply@example.com"
  },
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/orleans-samai/soc-investigation-lab",
  "repository": "github:orleans-samai/soc-investigation-lab",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node build.mjs",
    "dist:dir": "node build.mjs --dir"
  },
  "build": {
    "appId": "io.github.soclab.investigation",
    "productName": "SOC Investigation Lab",
    "copyright": "Educational project - all data is synthetic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "loading.html",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/soclab-server",
        "to": "server"
      },
      {
        "from": "../frontend/out",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SOC Investigation Lab",
      "artifactName": "SOC-Investigation-Lab-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "synopsis": "SOC analyst training simulator",
      "artifactName": "SOC-Investigation-Lab-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
