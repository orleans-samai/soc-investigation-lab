  "challenge": [
    {
      "id": "parent",
      "question": "Which process launched the malicious PowerShell?",
      "kind": "choice",
      "answers": [
        "WINWORD.EXE"
      ],
      "hint": "The 4688 event for powershell.exe has a ParentProcessName field.",
      "explanation": "Word spawning PowerShell is a strong macro-malware signal; Office should not start interpreters.",
      "options": [
        "explorer.exe",
        "WINWORD.EXE",
        "OUTLOOK.EXE",
        "svchost.exe"
      ]
    },
    {
      "id": "c2",
      "question": "Which external IP address served the second-stage payload?",
      "kind": "text",
      "answers": [
        "203.0.113.80"
      ],
      "hint": "Decode the -EncodedCommand (the alert shows it) or read the 4104 script blocks.",
      "explanation": "The decoded command downloads http://203.0.113.80/update.ps1: block it at the proxy and firewall."
    },
    {
      "id": "technique",
      "question": "Which ATT&CK technique matches clearing the Security log?",
      "kind": "choice",
      "answers": [
        "T1070.001"
      ],
      "hint": "Look at the MITRE mapping of the LAB-010 alert.",
      "explanation": "T1070.001 Indicator Removal: Clear Windows Event Logs (event 1102).",
