{
  "id": "powershell-download-cradle",
  "name": "Malicious macro, PowerShell download cradle and log clearing",
  "summary": "A finance user opens a weaponised document; Word spawns an encoded PowerShell that downloads a second stage, then the Security log is wiped.",
  "narrative": "A finance analyst receives an invoice-themed document. When macros are enabled, WINWORD.EXE launches a hidden, encoded PowerShell command that downloads and executes a script from an external server. Script Block Logging records the decoded content. Minutes later the Security event log on the workstation is cleared.",
  "category": "Execution",
  "level": "N2",
  "expected_severity": "critical",
  "expected_rules": [
    "LAB-009",
    "LAB-010",
    "LAB-016",
    "LAB-017"
  ],
  "mitre": [
    "T1566",
    "T1204.002",
    "T1059.001",
    "T1027",
    "T1105",
    "T1070.001",
    "T1071"
  ],
  "hosts": [
    "ws-fin-01"
  ],
  "learning_objectives": [
    "Spot abnormal parent/child process chains (Office spawning PowerShell).",
    "Decode -EncodedCommand payloads safely and extract IOCs.",
    "Understand why clearing the audit log is a critical signal."
  ],
  "investigation_questions": [
    "Which process launched PowerShell, and why is that unusual?",
    "What is the decoded command and which external host does it contact?",
    "Which IOCs (URL, IP, file names) should be blocked?",
    "Which evidence may have been lost when the log was cleared, and where else can you recover it?"
  ],
  "variables": {
    "doc": [
      "Invoice_2026-10.docm",
      "Payment_Advice.docm",
      "Supplier_Update.docm"
    ]
  },
  "steps": [
