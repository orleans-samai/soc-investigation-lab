        "T1059.001",
        "T1105",
        "T1070.001",
        "T1027"
      ]
    },
    {
      "id": "user",
      "question": "Which user account ran the malicious document?",
      "kind": "text",
      "answers": [
        "j.silva",
        "corp\\j.silva"
      ],
      "hint": "SubjectUserName of the WINWORD/PowerShell 4688 events.",
      "explanation": "j.silva (Finance) opened the document; her credentials and workstation must be treated as compromised."
    }
  ]
