{
  "id": "windows-password-spray",
  "name": "Password spraying against Active Directory",
  "summary": "An external VPS tries one weak password against many domain accounts, brute-forces the built-in Administrator and finally gets in as a sales user.",
  "narrative": "The domain controller receives NTLM network logons from an address that does not belong to the company. Most usernames are tried once or twice with a seasonal password; the Administrator account is attacked harder. One user still had the weak password.",
  "category": "Credential Access",
  "level": "N1",
  "expected_severity": "critical",
  "expected_rules": ["LAB-002", "LAB-003", "LAB-004"],
  "mitre": ["T1110.003", "T1110.001", "T1078"],
  "hosts": ["dc-01"],
  "learning_objectives": [
    "Differentiate password spraying (many users, few attempts) from brute force (one user, many attempts).",
    "Interpret Windows 4625 Status/SubStatus codes.",
    "Identify which sprayed account was actually compromised."
  ],
  "investigation_questions": [
    "How many distinct accounts were targeted and how many attempts per account?",
    "Which SubStatus codes reveal non-existent accounts versus wrong passwords?",
    "Which account logged on successfully afterwards and from where?",
    "Was the Administrator account locked out?"
  ],
  "variables": {
    "attacker_ip": ["198.51.100.23", "198.51.100.61", "198.51.100.88"]
  },
  "steps": [
    {
      "format": "windows_json",
      "offset_seconds": 0,
      "repeat": 8,
      "interval_seconds": [4, 12],
      "random_int": {"port": [49152, 65535]},
      "record": {
        "EventID": 4625, "TimeCreated": "{ts}", "Computer": "DC-01.corp.lab", "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing", "Level": "Information",
        "EventData": {"TargetUserName": "Administrator", "TargetDomainName": "CORP", "LogonType": "3",
                      "IpAddress": "{attacker_ip}", "IpPort": "{port}", "WorkstationName": "KALI",
                      "Status": "0xc000006d", "SubStatus": "0xc000006a"}
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 120,
      "repeat": 12,
      "interval_seconds": [6, 18],
      "cycle": {
        "user": ["j.silva", "m.santos", "a.costa", "r.oliveira", "c.souza", "backup", "helpdesk", "j.silva", "l.pereira", "scanner", "m.santos", "guest"],
        "sub": ["0xc000006a", "0xc000006a", "0xc000006a", "0xc000006a", "0xc000006a", "0xc0000064", "0xc0000064", "0xc000006a", "0xc000006a", "0xc0000064", "0xc000006a", "0xc0000064"]
      },
      "random_int": {"port": [49152, 65535]},
      "record": {
        "EventID": 4625, "TimeCreated": "{ts}", "Computer": "DC-01.corp.lab", "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing", "Level": "Information",
        "EventData": {"TargetUserName": "{user}", "TargetDomainName": "CORP", "LogonType": "3",
                      "IpAddress": "{attacker_ip}", "IpPort": "{port}", "WorkstationName": "KALI",
                      "Status": "0xc000006d", "SubStatus": "{sub}"}
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 330,
      "random_int": {"port": [49152, 65535]},
      "record": {
        "EventID": 4625, "TimeCreated": "{ts}", "Computer": "DC-01.corp.lab", "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing", "Level": "Information",
        "EventData": {"TargetUserName": "l.pereira", "TargetDomainName": "CORP", "LogonType": "3",
                      "IpAddress": "{attacker_ip}", "IpPort": "{port}", "WorkstationName": "KALI",
                      "Status": "0xc000006d", "SubStatus": "0xc000006a"}
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 345,
      "random_int": {"port": [49152, 65535]},
      "record": {
        "EventID": 4624, "TimeCreated": "{ts}", "Computer": "DC-01.corp.lab", "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing", "Level": "Information",
        "EventData": {"TargetUserName": "l.pereira", "TargetDomainName": "CORP", "LogonType": "3",
                      "IpAddress": "{attacker_ip}", "IpPort": "{port}", "WorkstationName": "KALI",
                      "AuthenticationPackageName": "NTLM"}
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 400,
      "random_int": {"port": [49152, 65535]},
      "record": {
        "EventID": 4624, "TimeCreated": "{ts}", "Computer": "FS-01.corp.lab", "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing", "Level": "Information",
        "EventData": {"TargetUserName": "l.pereira", "TargetDomainName": "CORP", "LogonType": "3",
                      "IpAddress": "{attacker_ip}", "IpPort": "{port}", "WorkstationName": "KALI",
                      "AuthenticationPackageName": "NTLM"}
      }
    }
  ]
}
