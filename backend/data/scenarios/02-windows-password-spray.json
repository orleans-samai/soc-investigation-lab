{
  "id": "windows-password-spray",
  "name": "Password spraying against Active Directory",
  "summary": "An external VPS tries one weak password against many domain accounts, brute-forces the built-in Administrator and finally gets in as a sales user.",
  "narrative": "The domain controller receives NTLM network logons from an address that does not belong to the company. Most usernames are tried once or twice with a seasonal password; the Administrator account is attacked harder. One user still had the weak password.",
  "category": "Credential Access",
  "level": "N1",
  "expected_severity": "critical",
  "expected_rules": [
    "LAB-002",
    "LAB-003",
    "LAB-004"
  ],
  "mitre": [
    "T1110.003",
    "T1110.001",
    "T1078"
  ],
  "hosts": [
    "dc-01"
  ],
  "learning_objectives": [
    "Differentiate password spraying (many users, few attempts) from brute force (one user, many attempts).",
    "Interpret Windows 4625 Status/SubStatus codes.",
    "Identify which sprayed account was actually compromised."
  ],
  "investigation_questions": [
    "How many distinct accounts were targeted and how many attempts per account?",
    "Which SubStatus codes reveal non-existent accounts versus wrong passwords?",
    "Which account logged on successfully afterwards and from where?",
    "Was the Administrator account locked out?"
  ],
  "variables": {
    "attacker_ip": [
      "198.51.100.23",
      "198.51.100.61",
      "198.51.100.88"
    ]
  },
  "steps": [
    {
      "format": "windows_json",
      "offset_seconds": 0,
      "repeat": 8,
      "interval_seconds": [
        4,
        12
      ],
      "random_int": {
        "port": [
          49152,
          65535
        ]
      },
      "record": {
        "EventID": 4625,
        "TimeCreated": "{ts}",
        "Computer": "DC-01.corp.lab",
        "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing",
        "Level": "Information",
        "EventData": {
          "TargetUserName": "Administrator",
          "TargetDomainName": "CORP",
          "LogonType": "3",
          "IpAddress": "{attacker_ip}",
          "IpPort": "{port}",
          "WorkstationName": "KALI",
          "Status": "0xc000006d",
          "SubStatus": "0xc000006a"
        }
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 120,
      "repeat": 12,
      "interval_seconds": [
        6,
        18
      ],
      "cycle": {
        "user": [
          "j.silva",
          "m.santos",
          "a.costa",
          "r.oliveira",
          "c.souza",
          "backup",
          "helpdesk",
          "j.silva",
          "l.pereira",
          "scanner",
          "m.santos",
          "guest"
        ],
        "sub": [
          "0xc000006a",
          "0xc000006a",
          "0xc000006a",
          "0xc000006a",
          "0xc000006a",
          "0xc0000064",
          "0xc0000064",
          "0xc000006a",
          "0xc000006a",
          "0xc0000064",
          "0xc000006a",
          "0xc0000064"
        ]
      },
      "random_int": {
        "port": [
          49152,
          65535
        ]
      },
      "record": {
        "EventID": 4625,
        "TimeCreated": "{ts}",
        "Computer": "DC-01.corp.lab",
        "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing",
        "Level": "Information",
        "EventData": {
          "TargetUserName": "{user}",
          "TargetDomainName": "CORP",
          "LogonType": "3",
          "IpAddress": "{attacker_ip}",
          "IpPort": "{port}",
          "WorkstationName": "KALI",
          "Status": "0xc000006d",
          "SubStatus": "{sub}"
        }
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 330,
      "random_int": {
        "port": [
          49152,
          65535
        ]
      },
      "record": {
        "EventID": 4625,
        "TimeCreated": "{ts}",
        "Computer": "DC-01.corp.lab",
        "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing",
        "Level": "Information",
        "EventData": {
          "TargetUserName": "l.pereira",
          "TargetDomainName": "CORP",
          "LogonType": "3",
          "IpAddress": "{attacker_ip}",
          "IpPort": "{port}",
          "WorkstationName": "KALI",
          "Status": "0xc000006d",
          "SubStatus": "0xc000006a"
        }
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 345,
      "random_int": {
        "port": [
          49152,
          65535
        ]
      },
      "record": {
        "EventID": 4624,
        "TimeCreated": "{ts}",
        "Computer": "DC-01.corp.lab",
        "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing",
        "Level": "Information",
        "EventData": {
          "TargetUserName": "l.pereira",
          "TargetDomainName": "CORP",
          "LogonType": "3",
          "IpAddress": "{attacker_ip}",
          "IpPort": "{port}",
          "WorkstationName": "KALI",
          "AuthenticationPackageName": "NTLM"
        }
      }
    },
    {
      "format": "windows_json",
      "offset_seconds": 400,
      "random_int": {
        "port": [
          49152,
          65535
        ]
      },
      "record": {
        "EventID": 4624,
        "TimeCreated": "{ts}",
        "Computer": "FS-01.corp.lab",
        "Channel": "Security",
        "Provider": "Microsoft-Windows-Security-Auditing",
        "Level": "Information",
        "EventData": {
          "TargetUserName": "l.pereira",
          "TargetDomainName": "CORP",
          "LogonType": "3",
          "IpAddress": "{attacker_ip}",
          "IpPort": "{port}",
          "WorkstationName": "KALI",
          "AuthenticationPackageName": "NTLM"
        }
      }
    }
  ],
  "challenge": [
    {
      "id": "source_ip",
      "question": "From which IP address did the attack come?",
      "kind": "text",
      "answers": [
        "{attacker_ip}"
      ],
      "hint": "All the 4625 events on dc-01 share the same IpAddress field.",
      "explanation": "The failed NTLM logons and the later success all came from {attacker_ip}."
    },
    {
      "id": "accounts",
      "question": "How many distinct accounts were targeted (failed logons)?",
      "kind": "text",
      "answers": [
        "11",
        "eleven"
      ],
      "hint": "Open the Password Spraying alert (LAB-003): its evidence lists the distinct accounts.",
      "explanation": "Administrator plus 10 other usernames, some of them non-existent, were tried about twice each: classic spraying."
    },
    {
      "id": "substatus",
      "question": "Which 4625 SubStatus code means the username does not exist?",
      "kind": "choice",
      "answers": [
        "0xc0000064"
      ],
      "hint": "Compare the failure_reason field of events for 'backup' or 'guest' with those for real users.",
      "explanation": "0xc0000064 = user does not exist; 0xc000006a = wrong password. Non-existent names reveal a wordlist, not a confused user.",
      "options": [
        "0xc000006a",
        "0xc0000064",
        "0xc0000234",
        "0xc000006d"
      ]
    },
    {
      "id": "compromised",
      "question": "Which account did the attacker finally log in with?",
      "kind": "choice",
      "answers": [
        "l.pereira"
      ],
      "hint": "Look for a 4624 from the attacker IP after the burst (rule LAB-004).",
      "explanation": "l.pereira authenticated to dc-01 and then fs-01 from the attacker's address: the weak password was guessed.",
      "options": [
        "administrator",
        "j.silva",
        "l.pereira",
        "m.santos"
      ]
    }
  ]
}
