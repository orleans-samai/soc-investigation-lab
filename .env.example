# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Backend (FastAPI) ---------------------------------------------------------
# Timezone used to evaluate "business hours" rules and naive timestamps.
SOCLAB_LAB_TIMEZONE=America/Sao_Paulo
SOCLAB_BUSINESS_HOURS_START=7
SOCLAB_BUSINESS_HOURS_END=20

# Upload limits for the log import endpoint.
SOCLAB_MAX_UPLOAD_MB=5
SOCLAB_MAX_IMPORT_LINES=50000

# Where mutable lab state (events, alerts, incidents...) is written. Safe to delete: rebuilt from the seed.
# SOCLAB_STATE_DIR=./backend/state

# Origins allowed to call the API directly (the Next.js app proxies /api, so this is only for local tools).
SOCLAB_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend (Next.js) --------------------------------------------------------
# Where the Next server proxies /api/* (read at build time).
BACKEND_URL=http://127.0.0.1:8000
